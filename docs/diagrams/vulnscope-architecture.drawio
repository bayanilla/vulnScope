<mxfile host="app.diagrams.net" type="device"><diagram id="vulnscope-arch" name="VulnScope architecture"><mxGraphModel dx="1800" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;VulnScope architecture&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" value="bayanilla/vulnScope, main at eb72997 (2026-11-22). Built from ARCHITECTURE.md and the code. Solid arrows: analysis path. Dashed: optional outbound." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="22" as="geometry"/></mxCell><mxCell id="inputs" value="&lt;b&gt;Inputs&lt;/b&gt; &amp;middot; your files, read-only" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;opacity=100;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="250" height="680" as="geometry"/></mxCell><mxCell id="docker" value="&lt;b&gt;Docker container&lt;/b&gt; &amp;middot; image &lt;b&gt;ghcr.io/bayanilla/vulnscope&lt;/b&gt; (zeek/zeek 9.0.1 base, linux/amd64 + arm64) &amp;middot; published on 127.0.0.1:8765 &amp;rarr; 8080 &amp;middot; /data read-only, /runs read-write &amp;middot; read-only root, not root" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;opacity=100;fillColor=#f8fafc;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1110" height="800" as="geometry"/></mxCell><mxCell id="runs" value="&lt;b&gt;Run folder&lt;/b&gt; &amp;middot; /runs/&amp;lt;id&amp;gt;/ (vulnflow_runs/ natively)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;opacity=100;" vertex="1" parent="1"><mxGeometry x="1440" y="110" width="340" height="760" as="geometry"/></mxCell><mxCell id="outbound" value="&lt;b&gt;Optional outbound&lt;/b&gt; &amp;middot; the only connections out; each tied to a setting or a click. The analysis path never contacts hosts or addresses in your data." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#0f172a;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;opacity=100;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="900" width="1450" height="110" as="geometry"/></mxCell><mxCell id="in_pcap" value="&lt;b&gt;Packet captures&lt;/b&gt;&lt;br&gt;.pcap / .pcapng" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="150" width="220" height="66" as="geometry"/></mxCell><mxCell id="in_zeek" value="&lt;b&gt;Zeek logs&lt;/b&gt;&lt;br&gt;TSV / JSON, Zui (Brim) export" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="229" width="220" height="66" as="geometry"/></mxCell><mxCell id="in_fb" value="&lt;b&gt;Filebeat exports&lt;/b&gt;&lt;br&gt;Kibana CSV / NDJSON (Zeek module)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="308" width="220" height="66" as="geometry"/></mxCell><mxCell id="in_pa" value="&lt;b&gt;Palo Alto&lt;/b&gt;&lt;br&gt;traffic / threat CSV" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="387" width="220" height="66" as="geometry"/></mxCell><mxCell id="in_vpc" value="&lt;b&gt;AWS VPC Flow Logs&lt;/b&gt;&lt;br&gt;text or Parquet" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="466" width="220" height="66" as="geometry"/></mxCell><mxCell id="in_sur" value="&lt;b&gt;Suricata eve.json&lt;/b&gt;,&lt;br&gt;generic flow CSV" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="545" width="220" height="66" as="geometry"/></mxCell><mxCell id="in_nessus" value="&lt;b&gt;Nessus scans&lt;/b&gt;&lt;br&gt;.nessus XML or CSV export" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="624" width="220" height="66" as="geometry"/></mxCell><mxCell id="in_ioc" value="&lt;b&gt;Optional lists&lt;/b&gt;&lt;br&gt;IOC CSV, network_map.csv,&lt;br&gt;known_scanners.csv, sites.csv" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="35" y="703" width="220" height="66" as="geometry"/></mxCell><mxCell id="incident" value="&lt;b&gt;VulnScope Incident&lt;/b&gt;&lt;br&gt;separate tool (bayanilla/vulnscope_incident),&lt;br&gt;not part of this image" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#475569;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;vulnflow CLI&lt;/b&gt; (cli.py)&lt;br&gt;analyze &amp;middot; explore &amp;middot; serve&lt;br&gt;compare &amp;middot; analyze-sites&lt;br&gt;ask &amp;middot; brief &amp;middot; samples" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="200" height="135" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;Upload page&lt;/b&gt; &amp;middot; web/server.py, handler.py, routes.py &amp;middot; 127.0.0.1 only, Host / Origin / CSRF checks, streamed uploads" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;opacity=100;" vertex="1" parent="1"><mxGeometry x="550" y="112" width="840" height="148" as="geometry"/></mxCell><mxCell id="p_up" value="&lt;b&gt;Analyze&lt;/b&gt;&lt;br&gt;upload.py&lt;br&gt;upload, folder path" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="562" y="158" width="127" height="90" as="geometry"/></mxCell><mxCell id="p_fold" value="&lt;b&gt;Browse&lt;/b&gt;&lt;br&gt;folders.py&lt;br&gt;folder picker" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="699" y="158" width="127" height="90" as="geometry"/></mxCell><mxCell id="p_runs" value="&lt;b&gt;Results&lt;/b&gt;&lt;br&gt;runs.py&lt;br&gt;reports, Assistant,&lt;br&gt;Radar, briefs" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="836" y="158" width="127" height="90" as="geometry"/></mxCell><mxCell id="p_cmp" value="&lt;b&gt;Compare&lt;/b&gt;&lt;br&gt;compare_page.py&lt;br&gt;reports side by side" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="973" y="158" width="127" height="90" as="geometry"/></mxCell><mxCell id="p_set" value="&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;settings.py&lt;br&gt;AI provider, keys" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="158" width="127" height="90" as="geometry"/></mxCell><mxCell id="p_brand" value="&lt;b&gt;Branding&lt;/b&gt;&lt;br&gt;branding_page.py&lt;br&gt;name prefix, logo" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1247" y="158" width="127" height="90" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;pipeline.py&lt;/b&gt; orchestration &amp;middot; &lt;b&gt;resources.py&lt;/b&gt;: DuckDB gets 60% of RAM (cgroup aware), threads per CPU, spills to disk; one analysis at a time; parallel parse workers" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="278" width="1060" height="42" as="geometry"/></mxCell><mxCell id="zeek" value="&lt;b&gt;Zeek&lt;/b&gt;, runs offline&lt;br&gt;pcap.py: PCAP &amp;rarr; logs" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="345" width="150" height="58" as="geometry"/></mxCell><mxCell id="parse" value="&lt;b&gt;Format detection&lt;/b&gt; by content&lt;br&gt;(parsers/__init__.py)&lt;br&gt;&lt;br&gt;&lt;b&gt;Native DuckDB readers&lt;/b&gt;: Zeek conn TSV, Palo Alto CSV (native.py)&lt;br&gt;&lt;br&gt;&lt;b&gt;Python parsers&lt;/b&gt; (fallback + rest): zeek, filebeat, paloalto, vpcflow, suricata, generic, nessus&lt;br&gt;&lt;br&gt;normalize.py, schema.py &amp;rarr; Flow, ThreatEvent, Finding" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="425" width="220" height="215" as="geometry"/></mxCell><mxCell id="parquet" value="&lt;b&gt;Parquet&lt;/b&gt;&lt;br&gt;temp work dir&lt;br&gt;by sensor, day&lt;br&gt;Zeek/OT events zstd" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="470" width="160" height="120" as="geometry"/></mxCell><mxCell id="duck" value="&lt;b&gt;DuckDB&lt;/b&gt;&lt;br&gt;db.py, store.py&lt;br&gt;sort, de-duplicate across sensors, join with scan findings, IOC matching in SQL" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="460" width="205" height="140" as="geometry"/></mxCell><mxCell id="corr" value="&lt;b&gt;Correlation&lt;/b&gt;&lt;br&gt;correlate.py, model.sql&lt;br&gt;&lt;br&gt;exposure, blast radius,&lt;br&gt;indicator grading,&lt;br&gt;score &amp;rarr; P1 to P4&lt;br&gt;&lt;br&gt;netmap.py (on-prem / cloud)&lt;br&gt;scanners.py (scanner detection)&lt;br&gt;ioc_archive.py (IOC CSV)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="990" y="425" width="205" height="215" as="geometry"/></mxCell><mxCell id="report" value="&lt;b&gt;Report writer&lt;/b&gt;&lt;br&gt;report.py, visual.py,&lt;br&gt;diagram.py, explore.py&lt;br&gt;&lt;br&gt;results_schema.py&lt;br&gt;checks results.json" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="445" width="170" height="170" as="geometry"/></mxCell><mxCell id="assist" value="&lt;b&gt;Security Assistant&lt;/b&gt;&lt;br&gt;&lt;b&gt;offline_assistant.py&lt;/b&gt;: built-in offline provider, the default; no AI model, nothing leaves the machine&lt;br&gt;&lt;br&gt;llm.py adapters if chosen: Anthropic, OpenAI, self-hosted (OpenAI-compatible); grounding and redaction&lt;br&gt;&lt;i&gt;reads correlated results only, never raw logs; never on the scoring path&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="680" width="420" height="150" as="geometry"/></mxCell><mxCell id="compare" value="&lt;b&gt;Compare and sites&lt;/b&gt;&lt;br&gt;compare.py: IOCs and vulnerabilities in more than one saved report (re-hunts normalized/ with the same matcher)&lt;br&gt;&lt;br&gt;combine.py: all-networks Explorer, one island per report&lt;br&gt;sites.py: sites.csv &amp;rarr; one report per site" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="680" width="380" height="150" as="geometry"/></mxCell><mxCell id="o_docs" value="&lt;b&gt;Executive summary, technical report&lt;/b&gt;&lt;br&gt;.md and .html" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="152" width="300" height="112" as="geometry"/></mxCell><mxCell id="o_csv" value="&lt;b&gt;correlated_findings.csv&lt;/b&gt;&lt;br&gt;hostile_activity.svg" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="292" width="300" height="112" as="geometry"/></mxCell><mxCell id="o_json" value="&lt;b&gt;results.json&lt;/b&gt;&lt;br&gt;checked against docs/results.schema.json" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="432" width="300" height="112" as="geometry"/></mxCell><mxCell id="o_expl" value="&lt;b&gt;explorer.html&lt;/b&gt;&lt;br&gt;3D, Flat, Attack paths, Timeline&lt;br&gt;three.js bundled, data embedded" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="572" width="300" height="112" as="geometry"/></mxCell><mxCell id="o_norm" value="&lt;b&gt;normalized/&lt;/b&gt;&lt;br&gt;flows.csv, zeek_events.jsonl, ot_events.jsonl,&lt;br&gt;explorer_contacts.parquet&lt;br&gt;&lt;i&gt;(skip with &quot;Skip full copies&quot;)&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="712" width="300" height="112" as="geometry"/></mxCell><mxCell id="ob_ai" value="&lt;b&gt;Anthropic, OpenAI or your model server&lt;/b&gt;&lt;br&gt;only if chosen in Settings" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="345" y="945" width="335" height="52" as="geometry"/></mxCell><mxCell id="ob_radar" value="&lt;b&gt;Cloudflare Radar&lt;/b&gt;&lt;br&gt;token set, one indicator per click (Results page)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="705" y="945" width="335" height="52" as="geometry"/></mxCell><mxCell id="ob_brief" value="&lt;b&gt;OpenAI article briefs&lt;/b&gt;&lt;br&gt;per click (Results page)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1065" y="945" width="335" height="52" as="geometry"/></mxCell><mxCell id="ob_art" value="&lt;b&gt;IOC article previews&lt;/b&gt;&lt;br&gt;on by default; VULNSCOPE_OFFLINE=1 stops them" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea580c;fo