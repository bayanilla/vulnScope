<mxfile host="app.diagrams.net" type="device"><diagram id="vulnscope-arch" name="VulnScope architecture"><mxGraphModel dx="2010" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2010" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;VulnScope end to end&lt;/b&gt;: network telemetry and a vulnerability scan in, results out" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="900" height="30" as="geometry"/></mxCell><mxCell id="sub" value="bayanilla/vulnScope, main at eb72997 (2026-11-22). Traced from web/upload.py, pipeline.py, correlate.py, report.py and web/runs.py. The same path runs from the command line: vulnflow analyze &amp;lt;folder&amp;gt; -o &amp;lt;out&amp;gt;." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="22" as="geometry"/></mxCell><mxCell id="band1" value="&lt;b&gt;1 &amp;middot; Submit&lt;/b&gt; &amp;middot; the analyst and the upload page" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;opacity=100;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1970" height="330" as="geometry"/></mxCell><mxCell id="band2" value="&lt;b&gt;2 &amp;middot; Analyze&lt;/b&gt; &amp;middot; pipeline.run, inside the Docker container (or a native install)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;opacity=100;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1970" height="360" as="geometry"/></mxCell><mxCell id="band3" value="&lt;b&gt;3 &amp;middot; Results&lt;/b&gt; &amp;middot; run folder and results page" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;opacity=100;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1970" height="290" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Gather the files&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Network telemetry&lt;/b&gt; (needed): Zeek logs, packet captures, Palo Alto traffic/threat CSV, AWS VPC Flow Logs, Filebeat exports, Suricata, flow CSV&lt;br&gt;&lt;br&gt;&lt;b&gt;Vulnerability scan&lt;/b&gt; (optional): Nessus .nessus or CSV&lt;br&gt;&lt;br&gt;&lt;i&gt;Optional: IOC CSV, network_map.csv, known_scanners.csv&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="230" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Open the upload page&lt;/b&gt;&lt;br&gt;127.0.0.1:8765 (Docker)&lt;br&gt;or &lt;i&gt;vulnflow serve&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="185" width="180" height="100" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Report details&lt;/b&gt; (optional)&lt;br&gt;name, network, description&lt;br&gt;&lt;br&gt;&lt;b&gt;Options&lt;/b&gt;&lt;br&gt;internal networks (default: private ranges), IOC CSV, skip full copies" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="530" y="150" width="230" height="165" as="geometry"/></mxCell><mxCell id="a4" value="Are the files in a folder the server can read?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0f172a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="200" height="130" as="geometry"/></mxCell><mxCell id="a5a" value="&lt;b&gt;Analyze folder&lt;/b&gt;&lt;br&gt;type the path or Browse;&lt;br&gt;read in place, nothing copied" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1020" y="112" width="220" height="88" as="geometry"/></mxCell><mxCell id="a5b" value="&lt;b&gt;Upload files instead&lt;/b&gt;&lt;br&gt;folder, telemetry and scan fields; copied to the server, size limit" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#64748b;fontColor=#1e293b;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1020" y="222" width="220" height="95" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;Server checks&lt;/b&gt;&lt;br&gt;CSRF token, Host and Origin&lt;br&gt;one analysis at a time: a second one is refused before the upload is read" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1290" y="160" width="230" height="140" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;Run folder created&lt;/b&gt;&lt;br&gt;&amp;lt;report-name&amp;gt;_&amp;lt;date-time&amp;gt;&lt;br&gt;uploads streamed into it" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="230" height="140" as="geometry"/></mxCell><mxCell id="err" value="&lt;b&gt;Something the analyst can fix&lt;/b&gt; (busy, too large, bad address range, no readable telemetry): the message is shown on the upload page and the run folder is removed" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=10;" vertex="1" parent="1"><mxGeometry x="530" y="340" width="990" height="50" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;Sort the inputs&lt;/b&gt;&lt;br&gt;check internal ranges;&lt;br&gt;set aside network_map, known_scanners and IOC CSV; skip READMEs&lt;br&gt;&lt;br&gt;&lt;b&gt;PCAP &amp;rarr; Zeek&lt;/b&gt;, run offline" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="240" height="200" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;Read and normalize&lt;/b&gt;&lt;br&gt;format found by content;&lt;br&gt;DuckDB native readers for Zeek conn and Palo Alto CSV, Python parsers for the rest; one worker per file&lt;br&gt;&lt;br&gt;&amp;rarr; sessions, IDS / firewall alerts, Zeek events, scan findings" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="500" width="240" height="200" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;Store and de-duplicate&lt;/b&gt;&lt;br&gt;Parquet &amp;rarr; DuckDB&lt;br&gt;a session seen by two sensors counts once (clock-skew tolerance)&lt;br&gt;&lt;br&gt;bad rows dropped and counted" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="230" height="200" as="geometry"/></mxCell><mxCell id="e4" value="Any telemetry read?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0f172a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="535" width="160" height="130" as="geometry"/></mxCell><mxCell id="e5" value="Scan findings?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0f172a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1030" y="535" width="170" height="130" as="geometry"/></mxCell><mxCell id="e6" value="&lt;b&gt;Correlate each finding&lt;/b&gt; (correlate.py, model.sql)&lt;br&gt;&lt;br&gt;&lt;b&gt;Exposure&lt;/b&gt;: did traffic reach the vulnerable port, from the internet or inside, in the scan window&lt;br&gt;&lt;b&gt;Blast radius&lt;/b&gt;: what the host talks to&lt;br&gt;&lt;b&gt;Indicators&lt;/b&gt;: leads (IDS alert, return connection, lateral spread, exfil); corroborated only with an alert plus follow-up contact&lt;br&gt;&lt;br&gt;&lt;b&gt;Score &amp;rarr; P1&lt;/b&gt; act now &amp;middot; &lt;b&gt;P2&lt;/b&gt; this cycle &amp;middot; &lt;b&gt;P3&lt;/b&gt; scheduled &amp;middot; &lt;b&gt;P4&lt;/b&gt; routine" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="475" width="300" height="235" as="geometry"/></mxCell><mxCell id="e6b" value="&lt;b&gt;Telemetry only&lt;/b&gt;: hosts listed with their traffic,&lt;br&gt;no vulnerability score or priority" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="725" width="300" height="58" as="geometry"/></mxCell><mxCell id="e7" value="&lt;b&gt;Enrich&lt;/b&gt;&lt;br&gt;network names from network_map.csv&lt;br&gt;&lt;br&gt;IOC CSV matches (in SQL)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#c2410c&quot;&gt;IOC article previews (optional outbound; VULNSCOPE_OFFLINE=1 stops them)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1560" y="475" width="190" height="235" as="geometry"/></mxCell><mxCell id="e8" value="&lt;b&gt;Write the run folder&lt;/b&gt;&lt;br&gt;results.json checked against its schema; reports, CSVs, Explorer&lt;br&gt;&lt;br&gt;temporary Parquet, DuckDB and Zeek files deleted" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1780" y="475" width="190" height="235" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Results page&lt;/b&gt;&lt;br&gt;/runs/&amp;lt;id&amp;gt;/&lt;br&gt;&lt;br&gt;the analyst lands here when the run ends; links to every file below" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="240" height="200" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Reports&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Executive summary&lt;/b&gt; (HTML, Markdown): what to fix first, in plain words&lt;br&gt;&lt;br&gt;&lt;b&gt;Technical report&lt;/b&gt;: each finding with its evidence; hostile activity diagram" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="905" width="290" height="185" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Data&lt;/b&gt;&lt;br&gt;&lt;br&gt;correlated_findings.csv, results.json&lt;br&gt;normalized/: flows, findings, IDS alerts, probed addresses, Zeek and industrial events" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="905" width="300" height="185" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Explorer&lt;/b&gt; (explorer.html)&lt;br&gt;&lt;br&gt;3D, Flat, Attack paths, Timeline&lt;br&gt;click a host: who is targeting it and how far a compromise could reach" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="905" width="290" height="185" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Security Assistant&lt;/b&gt;&lt;br&gt;&lt;br&gt;brief and questions about this run; built-in offline by default, or the AI provider chosen in Settings&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#c2410c&quot;&gt;Cloudflare Radar lookups and article briefs, per click&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1300" y="905" width="330" height="185" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;Later: Compare reports&lt;/b&gt;&lt;br&gt;&lt;br&gt;IOCs and vulnerabilities seen in more than one report; all networks on one Explorer map" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1680" y="905" width="290" height="185" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5152;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5152;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="yes" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="156"/></Array></mxGeometry></mxCell><mxCell id="e4" value="no" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5053;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="235"/><mxPoint x="1005" y="270"/></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3214;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5a" target="u1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="156"/><mxPoint x="1265" y="205"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5053;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.6786;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5b" target="u1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="270"/><mxPoint x="1265" y="255"/></Array></mxGeometry></mxCell><mxCell id="e7" value="ok" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="refused" style="edgeSt